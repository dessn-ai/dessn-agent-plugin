{
  "name": "dessn",
  "displayName": "Dessn",
  "version": "1.0.91",
  "description": "You can now use Dessn from your favourite agent. More convenient, more context. And all the visual power of Dessn.",
  "author": {
    "name": "Dessn",
    "url": "https://dessn.ai"
  },
  "homepage": "https://mcp.dessn.ai/install",
  "repository": "https://github.com/dessn-ai/dessn-agent-plugin",
  "license": "MIT",
  "privacyPolicyUrl": "https://www.dessn.com/privacy",
  "keywords": [
    "dessn",
    "dessn canvas",
    "dessn mcp"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/session-fact.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/session-fact.sh\""
          }
        ]
      }
    ]
  }
}

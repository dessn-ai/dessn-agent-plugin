{
  "name": "dessn",
  "displayName": "Dessn",
  "version": "1.0.88",
  "description": "The visual layer for designing and building with your agent: see your real app live on a Dessn canvas, spot where screens drift from your design system, and map whole user journeys.",
  "author": {
    "name": "Dessn",
    "url": "https://dessn.ai"
  },
  "homepage": "https://mcp.dessn.ai/install",
  "repository": "https://github.com/dessn-ai/dessn-agent-plugin",
  "license": "MIT",
  "privacyPolicyUrl": "https://www.dessn.com/privacy",
  "keywords": [
    "dessn",
    "dessn canvas",
    "dessn mcp",
    "dessn board",
    "dessn design agent"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/session-fact.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/session-fact.sh\""
          }
        ]
      }
    ]
  }
}
